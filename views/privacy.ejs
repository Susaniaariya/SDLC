  .policy-body h4 { margin-top: 2rem; margin-bottom: 0.5rem; font-size: 1.1rem; }
  .policy-body p, .policy-body ul { color: var(--ink-soft); line-height: 1.75; }
  .policy-body ul { padding-left: 1.4rem; }
  .policy-body li { margin-bottom: 0.35rem; }
  .policy-body a { color: var(--brand); }
</style>
