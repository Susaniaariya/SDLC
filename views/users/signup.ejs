<% layout("/layouts/boilerplate") %>
<div class="auth-wrap">
    <div class="auth-card">
        <div class="form-panel text-center">
            <i class="fa-regular fa-compass d-block mb-2" style="color: var(--brand);"></i>
            <h1 class="h3">Join YatraStay</h1>
            <p class="auth-subtitle">Create an account to start exploring stays</p>

            <form action = "/signup" method = "POST" class = "needs-validation text-start" novalidate>
                <div class="mb-3">
                    <label for="username" class="form-label">Username</label>
                    <input  name="username" id = "username" class="form-control" type = "text" required/>
                    <div class = "valid-feedback">Looks good!</div>
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input  name="email" id = "email" class="form-control" type = "email" required/>
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <input  name= "password" id = "password" class="form-control" type = "password" required/>
                    <div class = "valid-feedback">Looks good!</div>
                </div>
                <button class = "btn btn-success w-100 mt-2">Sign up</button>
            </form>

            <p class="mt-3 mb-0 auth-subtitle">Already have an account? <a href="/login">Log in</a></p>
        </div>
    </div>
</div>
