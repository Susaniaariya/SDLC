<% layout("layouts/boilerplate.ejs") %>

<!-- HERO -->
<section class="home-hero" style="background-image: url('/images/heritage/bagan.jpg');">
  <div class="home-hero-overlay">
    <span class="home-eyebrow"><i class="fa-solid fa-key me-2"></i>Become a host</span>
    <h1>Share your space.<br />Welcome the world.</h1>
    <p>List your home, room or property on YatraStay and earn from travellers exploring Southeast Asia and beyond.</p>
    <div class="home-hero-actions">
      <a href="/host/new" class="btn btn-light btn-lg">Get started hosting</a>
    </div>
  </div>
</section>

<!-- WHY HOST -->
<section class="home-section">
  <span class="section-eyebrow"><i class="fa-solid fa-house-chimney-window"></i>Why host with us</span>
  <h2 class="section-title">Hosting is simpler than you think</h2>

  <div class="row g-3 mt-2">
    <div class="col-sm-6 col-lg-3">
      <div class="feature-card">
        <i class="fa-solid fa-sack-dollar"></i>
        <h5>Earn extra income</h5>
        <p>Set your own price and turn your extra space into earnings.</p>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="feature-card">
        <i class="fa-solid fa-sliders"></i>
        <h5>You're in control</h5>
        <p>Choose your price, availability and house rules.</p>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="feature-card">
        <i class="fa-solid fa-shield-heart"></i>
        <h5>Reviews you can trust</h5>
        <p>Guests rate honestly, so good hosting is always rewarded.</p>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="feature-card">
        <i class="fa-solid fa-circle-check"></i>
        <h5>Free to list</h5>
        <p>Creating a listing takes a few minutes and costs nothing.</p>
      </div>
    </div>
  </div>
</section>

<div class="motif-divider"><i class="fa-solid fa-dharmachakra"></i></div>

<!-- HOW IT WORKS -->
<section class="home-section" style="padding-top: 0;">
  <span class="section-eyebrow"><i class="fa-solid fa-map-location-dot"></i>How it works</span>
  <h2 class="section-title">Three steps to your first guest</h2>

  <div class="row g-3 mt-2">
    <div class="col-md-4">
      <div class="feature-card h-100">
        <i class="fa-solid fa-house"></i>
        <h5>1. Tell us about your place</h5>
        <p>Pick a property type and share where it's located.</p>
      </div>
    </div>
    <div class="col-md-4">
      <div class="feature-card h-100">
        <i class="fa-solid fa-image"></i>
        <h5>2. Make it stand out</h5>
        <p>Add a title, a description and a great photo.</p>
      </div>
    </div>
    <div class="col-md-4">
      <div class="feature-card h-100">
        <i class="fa-solid fa-circle-check"></i>
        <h5>3. Publish your listing</h5>
        <p>Set your price and go live to travellers right away.</p>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="home-cta">
  <h2>Ready to host?</h2>
  <p>It only takes a few minutes to create your first listing.</p>
  <a href="/host/new" class="btn btn-light btn-lg">Get started hosting</a>
</section>
