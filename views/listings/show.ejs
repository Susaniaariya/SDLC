<% layout("layouts/boilerplate") %>

<div class="row mt-3">
  <div class="col-10 offset-1 col-lg-8 offset-lg-2 listing-hero text-center">
    <h3><%= listing.title %></h3>
    <p class="listing-meta">
      <% if (listing.propertyType) { %><span class="property-type-badge"><%= listing.propertyType %></span><% } %>
      <i class="fa-solid fa-location-dot me-1"></i><%= listing.location %>, <%= listing.country %>
    </p>
  </div>

  <div class="card col-10 offset-1 col-lg-6 offset-lg-3 show-card shadow-lg p-3 rounded-4 listing-card">
    <% const photos = (listing.images && listing.images.length) ? listing.images : (listing.image && listing.image.url ? [{ url: listing.image.url }] : []); %>
    <% if (photos.length > 1) { %>
      <div id="listingGallery" class="carousel slide rounded-4 overflow-hidden mb-0" data-bs-ride="false">
        <div class="carousel-indicators">
          <% for (let i = 0; i < photos.length; i++) { %>
            <button type="button" data-bs-target="#listingGallery" data-bs-slide-to="<%= i %>" class="<%= i === 0 ? 'active' : '' %>" aria-label="Photo <%= i + 1 %>"></button>
          <% } %>
        </div>
        <div class="carousel-inner">
          <% for (let i = 0; i < photos.length; i++) { %>
            <div class="carousel-item <%= i === 0 ? 'active' : '' %>">
              <img src="<%= photos[i].url %>" class="d-block w-100 show-img" alt="Listing photo <%= i + 1 %>">
            </div>
          <% } %>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#listingGallery" data-bs-slide="prev">
          <span class="carousel-control-prev-icon" aria-hidden="true"></span><span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#listingGallery" data-bs-slide="next">
          <span class="carousel-control-next-icon" aria-hidden="true"></span><span class="visually-hidden">Next</span>
        </button>
      </div>
    <% } else if (photos.length === 1) { %>
      <img src="<%= photos[0].url %>" class="card-img-top show-img rounded-4" alt="listing_image">
    <% } %>

    <div class="card-body">
      <!-- OWNER (SAFE) -->
      <div class="owner-chip">
        <div class="owner-avatar">
          <%= (listing.owner?.username || "?").charAt(0) %>
        </div>
        <div>
          <div class="text-muted small">Hosted by</div>
          <div class="owner-name"><%= listing.owner?.username || "Unknown" %></div>
        </div>
      </div>

      <p class="card-text"><%= listing.description %></p>
      <p class="listing-price mb-2">रु <%= Number(listing.price || 0).toLocaleString("en-NP") %> <span class="listing-meta" style="font-size: 0.95rem; font-weight: 400;">/ night</span></p>

      <!-- BOOKING -->
      <% const isOwnListing = currUser && listing.owner && currUser._id.equals(listing.owner._id); %>
      <% const fmtDay = (d) => new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" }); %>
      <div class="booking-card mt-3" id="book">
        <% if (isOwnListing) { %>
          <p class="listing-meta mb-0"><i class="fa-solid fa-circle-info me-1"></i>This is your listing, so guests will book it from here.</p>
        <% } else if (!currUser) { %>
          <h4 class="booking-title">Reserve your stay</h4>
          <p class="listing-meta mb-2">Log in to pick your dates and book.</p>
          <a href="/login" class="btn btn-brand">Log in to book</a>
        <% } else { %>
          <h4 class="booking-title">Reserve your stay</h4>
          <form action="/listings/<%= listing._id %>/bookings" method="POST" class="booking-form" data-price="<%= Number(listing.price || 0) %>">
            <div class="row g-2">
              <div class="col-6">
                <label class="form-label" for="checkIn">Check-in</label>
                <input type="date" id="checkIn" name="booking[checkIn]" class="form-control" required />
              </div>
              <div class="col-6">
                <label class="form-label" for="checkOut">Check-out</label>
                <input type="date" id="checkOut" name="booking[checkOut]" class="form-control" required />
              </div>
              <div class="col-12">
                <label class="form-label" for="guests">Guests</label>
                <select id="guests" name="booking[guests]" class="form-select">
                  <% for (let g = 1; g <= 10; g++) { %>
                    <option value="<%= g %>"><%= g %> guest<%= g > 1 ? "s" : "" %></option>
                  <% } %>
                </select>
              </div>
            </div>
            <p class="booking-total mt-3 mb-2" aria-live="polite">Pick your dates to see the total.</p>
            <button class="btn btn-brand w-100">Reserve</button>
          </form>
        <% } %>

        <% if (bookedRanges && bookedRanges.length) { %>
          <div class="booked-dates mt-3">
            <div class="small fw-semibold mb-1">Already booked</div>
            <ul class="list-unstyled mb-0 small text-muted">
              <% for (const r of bookedRanges) { %>
                <li><i class="fa-regular fa-calendar-xmark me-1"></i><%= fmtDay(r.checkIn) %> &ndash; <%= fmtDay(r.checkOut) %></li>
              <% } %>
            </ul>
          </div>
        <% } %>
      </div>

      <!-- EDIT / DELETE (SAFE) -->
      <% if (currUser && listing.owner && currUser._id.equals(listing.owner._id)) { %>
        <div class="mt-3 btns">
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark"><i class="fa-solid fa-pen me-1"></i>Edit</a>

          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
            <button class="btn btn-danger"><i class="fa-solid fa-trash me-1"></i>Delete</button>
          </form>
        </div>
      <% } %>

      <hr class="section-divider" />

      <!-- REVIEW FORM -->
      <div class="mb-3">
        <% if (currUser) { %>
          <h4>Leave a Review</h4>

          <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate>
            <fieldset class="starability-heartbeat">
              <legend>Rating</legend>

              <input type="radio" name="review[rating]" value="1" /> 1
              <input type="radio" name="review[rating]" value="2" /> 2
              <input type="radio" name="review[rating]" value="3" /> 3
              <input type="radio" name="review[rating]" value="4" /> 4
              <input type="radio" name="review[rating]" value="5" /> 5
            </fieldset>

            <div class="mb-3 mt-3">
              <label class="form-label">Comment</label>
              <textarea name="review[comment]" class="form-control" required></textarea>
            </div>

            <button class="btn btn-outline-dark">Submit</button>
          </form>
        <% } else { %>
          <p class="listing-meta"><a href="/login">Log in</a> to leave a review.</p>
        <% } %>
      </div>

      <!-- ALL REVIEWS -->
      <p class="mb-3"><b>All Reviews</b><% if (listing.reviews && listing.reviews.length) { %> <span class="text-muted">(<%= listing.reviews.length %>)</span><% } %></p>
      <div class="row g-3">
        <% if (!listing.reviews || listing.reviews.length === 0) { %>
          <p class="listing-meta">No reviews yet. Be the first to share your experience.</p>
        <% } %>
        <% for (let review of listing.reviews) { %>
          <div class="col-md-6">
            <div class="card review-card h-100">
              <div class="card-body">
                <div class="review-author">
                  <div class="review-avatar">
                    <%= (review.author ? review.author.username : "?").charAt(0) %>
                  </div>
                  <h5 class="card-title">
                    @<%= review.author ? review.author.username : "Deleted User" %>
                  </h5>
                </div>

                <p class="starability-result" data-rating="<%= review.rating %>">Rated: <%= review.rating %> stars</p>
                <p class="card-text"><%= review.comment %></p>

                <!-- REVIEW DELETE (SAFE) -->
                <% if (
                  currUser &&
                  (
                    (review.author && currUser._id.equals(review.author._id)) ||
                    (listing.owner && currUser._id.equals(listing.owner._id))
                  )
                ) { %>
                  <form
                    method="POST"
                    action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                  >
                    <button class="btn btn-sm btn-outline-dark"><i class="fa-solid fa-trash me-1"></i>Delete</button>
                  </form>
                <% } %>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
